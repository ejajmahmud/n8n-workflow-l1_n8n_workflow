      "parameters": {
        "jsCode": "const items = $input.all().map(x=>x.json);\nconst project = {\n  \"2\": \"Game Guides\",\n  \"5\": \"Game Client\",\n  \"6\": \"Game Round Result\",\n  \"7\": \"[Test] - Auto Translate\",\n  \"8\": \"Game Promotion\"\n}\nconst groupByProj = {}\nfor (const item of items) {\n  const projectId = item.project\n  const ns = item.keyNamespace\n  const key = `${projectId}_${ns}`\n  if (!groupByProj[key]) {\n    groupByProj[key] = {\n      ns: ns,\n      proj: project[projectId],\n      url: `https://tolgee.sabagame.com/projects/${projectId}/translations?filters={\"filterNamespace\":[\"${ns}\"]}`,\n      keys: []\n    }\n  }\n  groupByProj[key].keys.push(item.keyName)\n}\nconst output = Object.keys(groupByProj).map(x => ({\n  namespace: groupByProj[x].ns,\n  project: groupByProj[x].proj,\n  url: encodeURI(groupByProj[x].url),\n  numberOfWords: groupByProj[x].keys.length,\n  keys: groupByProj[x].keys.join(\",\")\n}))\n\n\n\nreturn output;"
      },
