        "jsCode": "const translation = []\nfor (const item of $input.all().map(x=>x.json)) {\n  for (const key of item.keys ?? []) {\n    for (const tag of Object.keys(key.translations)) {\n      translation.push({\n        id: key.translations[tag].id\n      })\n    }\n  }\n}\n\nreturn translation;"
