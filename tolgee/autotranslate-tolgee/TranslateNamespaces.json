    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const languageBase = $('Trigger').item.json.languageBase\nif (!$json.translations[languageBase]?.text) {\n  return {\n    value: $json.keyName,\n    missing: []\n  }\n}\nconst item = {\n  value: $json.translations[languageBase]?.text ?? $json.keyName,\n  keyName: $json.keyName,\n  keyNamespace: $json.keyNamespace,\n  project: $json.project,\n  missing: []\n}\nfor (const lang of $json.lang) {\n  if (!$json.translations[lang.tag] || $json.translations[lang.tag].state === \"UNTRANSLATED\") {\n    item.missing.push(lang)\n  } \n}\n\nreturn item;"
      },
